# Get this token from Telegram's @BotFather.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token

# Your private chat ID with the customer bot. Start it and send /adminid to find it.
CUSTOMER_SERVICE_CHAT_ID=123456789

# Private Telegram chat IDs that receive a complete alert after every successful
# customer booking. Start the PhotoLes customer bot and send /adminid to get yours.
# Multiple admins can be separated with commas.
ADMIN_NOTIFICATION_CHAT_IDS=123456789

# Times typed into the backend and shown to customers use this timezone.
SHOP_TIMEZONE=Asia/Singapore

# Optional. The default is data/photobooth.db.
# DATABASE_PATH=data/photobooth.db

# Required by the web admin dashboard. Generate a random secret with:
# python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY=replace-with-a-long-random-secret

# Every authorized username must have its own password. For a local setup, use:
# ADMIN_ACCOUNTS={"morgan":{"password":"replace-with-a-strong-password"},"taylor":{"password":"another-strong-password"}}
#
# For deployment, generate a separate hash for each account with:
# python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
# Then use the generated hashes below (keep this JSON on one line):
ADMIN_ACCOUNTS={"morgan":{"password_hash":"replace-with-morgans-generated-hash"},"taylor":{"password_hash":"replace-with-taylors-generated-hash"}}

# Set this to true only when the dashboard is served over HTTPS.
ADMIN_COOKIE_SECURE=false
# ADMIN_HOST=127.0.0.1
# ADMIN_PORT=8000
